{
  "name": "agent-trace",
  "version": "0.1.0",
  "description": "Capture agent LLM trajectories from any runtime and serialize them into SFT/RL-trainable records.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-trace": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "setup": "npm run build && npm link && node dist/cli.js install",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts"
  },
  "keywords": [
    "llm",
    "agent",
    "rl",
    "sft",
    "trajectory",
    "rollout",
    "fine-tuning",
    "openai",
    "anthropic",
    "proxy"
  ],
  "dependencies": {
    "@types/node-forge": "^1.3.14",
    "node-forge": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
